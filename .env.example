# Backend (Lovable Cloud / Supabase) — publishable values only, no secrets.
# Server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Browser-side (must be VITE_ prefixed to be exposed to the client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# LLM calls route through the Lovable AI Gateway, which injects LOVABLE_API_KEY
# into the server runtime automatically. Do not commit provider API keys.
