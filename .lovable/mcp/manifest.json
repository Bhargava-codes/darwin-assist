  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ydjwsbpsiaqskwoiwrfh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hr-assistant",
      "version": "0.1.0",
      "title": "HR Assistant"
    },
    "tools": [
      {
        "name": "get_my_hr_profile",
        "title": "Get my HR profile",
        "description": "Read the signed-in employee's HR profile: employee code, name, employment type, joining date, manager, location and grade band.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_leave_balances",
        "title": "Get leave balances",
        "description": "Read the signed-in employee's leave balances per leave code (CL, SL, EL, ML, PL, BL, UL) for a cycle year.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "cycle_year": {
              "description": "Leave cycle year. Defaults to the current calendar year.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_leave_requests",
        "title": "List leave requests",
        "description": "List the signed-in employee's leave requests, newest first, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return requests in this status.",
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED",
                "CANCELLED"
              ]
            },
            "limit": {
              "description": "Maximum rows to return. Defaults to 20.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_wfh_requests",
        "title": "List work-from-home requests",
        "description": "List the signed-in employee's work-from-home requests, newest first, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return requests in this status.",
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED",
                "CANCELLED"
              ]
            },
            "limit": {
              "description": "Maximum rows to return. Defaults to 20.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_hr_policy",
        "title": "Search HR policy",
        "description": "Keyword-search the company HR policy manual (leave, attendance, work-from-home) and return matching clauses with their clause ids so answers can cite them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Words to search for, e.g. 'casual leave notice period'."
            },
            "limit": {
              "description": "Maximum clauses to return. Defaults to 6.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  }
